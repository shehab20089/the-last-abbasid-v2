[sub_resource type="SystemFont" id="SystemFont_arabic"]
font_names = PackedStringArray("Tahoma", "Segoe UI", "Arial")
antialiasing = 0
hinting = 2
subpixel_positioning = 0

[sub_resource type="FontVariation" id="FontVariation_body"]
